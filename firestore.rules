rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsText(textId) {
      return signedIn() && exists(/databases/$(database)/documents/texts/$(textId))
        && get(/databases/$(database)/documents/texts/$(textId)).data.userId == request.auth.uid;
    }
    function writable(uid) { return !exists(spacePath(uid, 'control', 'maintenance')) || get(spacePath(uid, 'control', 'maintenance')).data.blocked == false; }
    function activeSource(uid, sourceId) { return get(spacePath(uid, 'sources', sourceId)).data.lifecycle == 'active'; }
    function activeUnit(uid, unitId) { return activeSource(uid, get(spacePath(uid, 'units', unitId)).data.sourceId); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function legacyWritesAllowed(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)/settings/profile)
        || get(/databases/$(database)/documents/users/$(uid)/settings/profile).data.get('legacyWritesLocked', false) == false;
    }
    function spacePath(uid, kind, id) {
      return /databases/$(database)/documents/users/$(uid)/$(kind)/$(id);
    }
    function nonblank(value, limit) {
      return value is string && value.size() <= limit
        && value.matches('[\\s\\S]*\\S[\\s\\S]*');
    }
    function spaceBase(data, uid, id) {
      return data.id == id && data.userId == uid && data.schemaVersion == 1
        && data.version is int && data.version >= 1 && data.version <= 1000000000
        && data.createdAt is timestamp
        && data.creationRequestHash is string && data.creationRequestHash.matches('sha256:[0-9a-f]{64}');
    }
    function newSpace(data, uid, id) {
      return spaceBase(data, uid, id) && data.version == 1 && data.createdAt == request.time;
    }
    function boundedCounter(value) { return value is int && value >= 0 && value <= 1000000; }
    function ordinal(value) { return value is int && value >= 0 && value <= 1000000; }
    function palaceShape(data, uid, id) {
      return data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'creationRequestHash', 'title', 'description', 'lifecycle', 'activeMacroCount', 'lastMutation'])
        && spaceBase(data, uid, id) && nonblank(data.title, 120)
        && data.description is string && data.description.size() <= 4000
        && data.lifecycle in ['active', 'archived'] && boundedCounter(data.activeMacroCount);
    }
    function macroShape(data, uid, id) {
      return data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'creationRequestHash', 'palaceId', 'name', 'spatialCue', 'ordinal', 'lifecycle', 'activeLocusCount', 'lastMutation'])
        && spaceBase(data, uid, id) && nonblank(data.name, 120) && nonblank(data.spatialCue, 4000)
        && data.palaceId is string && data.palaceId.size() > 0 && !data.palaceId.matches('.*[/].*')
        && ordinal(data.ordinal) && data.lifecycle in ['active', 'archived'] && boundedCounter(data.activeLocusCount);
    }
    function sensory(values) {
      return values is list && values.size() <= 6
        && (values.size() < 1 || nonblank(values[0], 200))
        && (values.size() < 2 || nonblank(values[1], 200))
        && (values.size() < 3 || nonblank(values[2], 200))
        && (values.size() < 4 || nonblank(values[3], 200))
        && (values.size() < 5 || nonblank(values[4], 200))
        && (values.size() < 6 || nonblank(values[5], 200));
    }
    function locusShape(data, uid, id) {
      return data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'creationRequestHash', 'palaceId', 'macroId', 'name', 'anchorDescription', 'sensoryCues', 'ordinal', 'state', 'activeEncodingId', 'usageCountLifetime'])
        && spaceBase(data, uid, id) && nonblank(data.name, 120) && nonblank(data.anchorDescription, 4000)
        && data.palaceId is string && data.palaceId.size() > 0 && !data.palaceId.matches('.*[/].*')
        && data.macroId is string && data.macroId.size() > 0 && !data.macroId.matches('.*[/].*')
        && ordinal(data.ordinal) && sensory(data.sensoryCues)
        && data.state in ['free', 'reserved', 'occupied', 'cooling', 'archived']
        && boundedCounter(data.usageCountLifetime)
        && ((data.state == 'occupied' && data.activeEncodingId is string)
          || (data.state != 'occupied' && data.activeEncodingId == null));
    }
    // Every mutation retains the exact previous document (native Firestore types).
    function hasSpaceHistory(uid, kind, id) {
      let previous = resource.data;
      let path = /databases/$(database)/documents/users/$(uid)/$(kind)/$(id)/revisions/$("v" + string(previous.version));
      return request.resource.data.version == previous.version + 1
        && getAfter(path).data == previous;
    }
    function parentTransition(uid, kind, id, counter, childId, action) {
      let path = spacePath(uid, kind, id);
      let before = get(path).data;
      let after = getAfter(path).data;
      let change = action == 'archive' ? -1 : 1;
      return before.userId == uid && before.lifecycle == 'active' && after.lifecycle == 'active'
        && after.version == before.version + 1 && after[counter] == before[counter] + change
        && after.lastMutation == {'action': action, 'childId': childId};
    }
    function childTransition(uid, kind, parentId, relation, lifecycleField, counter) {
      let mutation = request.resource.data.lastMutation;
      let path = spacePath(uid, kind, mutation.childId);
      let after = getAfter(path).data;
      return mutation.keys().hasOnly(['action', 'childId'])
        && after.userId == uid && after[relation] == parentId
        && ((mutation.action == 'create' && !exists(path) && after.version == 1 && after[lifecycleField] == (kind == 'microStations' ? 'free' : 'active')
            && request.resource.data[counter] == resource.data[counter] + 1)
          || (mutation.action in ['archive', 'restore'] && get(path).data.userId == uid
            && after.version == get(path).data.version + 1
            && get(path).data[lifecycleField] == (mutation.action == 'archive' ? (kind == 'microStations' ? 'free' : 'active') : 'archived')
            && after[lifecycleField] == (mutation.action == 'archive' ? 'archived' : (kind == 'microStations' ? 'free' : 'active'))
            && request.resource.data[counter] == resource.data[counter] + (mutation.action == 'archive' ? -1 : 1)));
    }
    function learningBase(d, uid, id) {
      return d.id == id && d.userId == uid && d.schemaVersion == 1
        && d.version is int && d.version >= 1 && d.version <= 1000000000 && d.createdAt is timestamp;
    }
    function learningNew(d, uid, id) { return learningBase(d, uid, id) && d.version == 1 && d.createdAt == request.time; }
    function digest(value) { return value is string && value.matches('sha256:[0-9a-f]{64}'); }
    function targets(mode) { return mode == 'literal' ? ['verbatim'] : mode == 'dual' ? ['concept', 'explanation', 'verbatim'] : ['concept', 'explanation']; }
    function unitShape(d, uid, id) {
      return d.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'sourceId', 'sourceRevisionId', 'unitRevision', 'ordinal', 'text', 'status', 'startOffset', 'endOffset', 'traceStatus', 'targetMode', 'targets', 'primaryConceptId', 'legacyRef', 'activeEncodingId'])
        && nonblank(d.text, 60000) && ordinal(d.ordinal) && d.unitRevision == 1 && d.traceStatus == 'resolved'
        && d.startOffset is int && d.endOffset is int && d.startOffset >= 0 && d.endOffset > d.startOffset && d.endOffset <= 120000;
    }
    function validDraft(d, uid, id) {
      return learningBase(d, uid, id) && d.id == d.unitId && d.updatedAt == request.time
        && d.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'updatedAt', 'unitId', 'sourceRevisionId', 'status', 'payload', 'step', 'publishedEncodingId'])
        && d.step is int && d.step >= 0 && d.step <= 7 && d.payload is map
        && d.payload.keys().hasOnly(['sourceReviewed', 'mode', 'conceptKind', 'unknownTerms', 'proposition', 'terms', 'premises', 'conclusion', 'why', 'quoteNecessary', 'needsResearch', 'foundational', 'foundation', 'linkedConceptId', 'edgeType', 'linkExplanation', 'palaceId', 'macroId', 'locusId', 'agent', 'action', 'symbol', 'distinctiveCue', 'sensoryDetails', 'mapping', 'prompt', 'distinction', 'mentalRehearsal', 'sceneDistinguished', 'entranceAttempted', 'entrancePassed', 'meaningConfirmed']);
    }
    function workshopGate(p) {
      return p.sourceReviewed == true && p.mode in ['conceptual', 'literal', 'dual'] && p.needsResearch == false
        && nonblank(p.proposition, 4000) && p.conceptKind in ['argument', 'definition', 'explanation', 'interpretation', 'sequence']
        && (p.conceptKind != 'argument' || (nonblank(p.premises, 4000) && nonblank(p.conclusion, 4000) && nonblank(p.why, 4000)))
        && (p.foundational == true ? nonblank(p.foundation, 4000) : (p.linkedConceptId is string && nonblank(p.linkExplanation, 4000)))
        && nonblank(p.agent, 4000) && nonblank(p.action, 4000) && nonblank(p.symbol, 4000) && nonblank(p.distinctiveCue, 4000) && nonblank(p.mapping, 4000)
        && p.mentalRehearsal == true && nonblank(p.prompt, 4000) && nonblank(p.distinction, 4000) && p.sceneDistinguished == true
        && p.entranceAttempted == true && p.entrancePassed == true && p.meaningConfirmed == true;
    }
    function gateMatches(g, p) {
      return g == {'sourceReviewed': true, 'objectiveSelected': true, 'foundational': p.foundational, 'foundationJustification': p.foundation, 'linkedConceptId': p.foundational ? null : p.linkedConceptId, 'sceneDistinguished': true, 'initialRecallAttempted': true, 'entranceExamPassed': true, 'userConfirmedMeaning': true};
    }
    function initialCardPresent(uid, encodingId, target) {
      return getAfter(spacePath(uid, 'cards', encodingId + '_' + target)).data.encodingId == encodingId;
    }
    function publishableEncoding(d, uid, id) {
      let draft = get(spacePath(uid, 'encodingDrafts', d.draftId)).data;
      let p = draft.payload;
      let unit = getAfter(spacePath(uid, 'units', d.unitId)).data;
      let unitBefore = get(spacePath(uid, 'units', d.unitId)).data;
      let locus = getAfter(spacePath(uid, 'microStations', d.locusId)).data;
      let concept = getAfter(spacePath(uid, 'concepts', d.conceptId)).data;
      return learningNew(d, uid, id) && d.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'unitId', 'unitRevision', 'sourceRevisionId', 'conceptId', 'conceptVersion', 'locusId', 'palaceId', 'macroId', 'scene', 'retrievalPrompt', 'qualityGate', 'status', 'requestHash', 'draftId', 'targets', 'edgeId'])
        && digest(d.requestHash) && d.status == 'active' && d.id == d.unitId + '_e1' && d.draftId == d.unitId
        && unit.version == unitBefore.version + 1 && unitBefore.status in ['needs_concept', 'needs_encoding'] && draft.status == 'draft' && draft.unitId == d.unitId && workshopGate(p) && gateMatches(d.qualityGate, p)
        && getAfter(spacePath(uid, 'encodingDrafts', d.draftId)).data.publishedEncodingId == id
        && unit.status == 'ready' && unit.activeEncodingId == id && unit.sourceRevisionId == d.sourceRevisionId && unit.unitRevision == d.unitRevision
        && (p.proposition != unit.text || p.quoteNecessary == true)
        && d.targets == targets(p.mode) && unit.targetMode == p.mode
        && concept.id == id + '_concept' && concept.canonicalProposition == p.proposition && concept.kind == p.conceptKind && d.conceptVersion == 1
        && locus.state == 'occupied' && locus.activeEncodingId == id && locus.macroId == d.macroId && locus.palaceId == d.palaceId && d.locusId == p.locusId && d.macroId == p.macroId && d.palaceId == p.palaceId
        // A free locus is already counted as active. Parent archival requires
        // zero active children, so these invariant-preserving rules imply an active route.
        && d.scene.keys().hasOnly(['agent', 'action', 'symbol', 'distinctiveCue', 'sensoryDetails', 'conceptMapping'])
        && d.scene.agent == p.agent && d.scene.action == p.action && d.scene.symbol == p.symbol && d.scene.distinctiveCue == p.distinctiveCue && d.scene.conceptMapping == p.mapping && d.scene.sensoryDetails is list
        && d.retrievalPrompt == p.prompt
        && (p.foundational ? d.edgeId == null : (d.edgeId == id + '_edge' && getAfter(spacePath(uid, 'conceptEdges', d.edgeId)).data.toConceptId == p.linkedConceptId))
        && (!d.targets.hasAny(['concept']) || initialCardPresent(uid, id, 'concept'))
        && (!d.targets.hasAny(['explanation']) || initialCardPresent(uid, id, 'explanation'))
        && (!d.targets.hasAny(['verbatim']) || initialCardPresent(uid, id, 'verbatim'));
    }
    function schedulerShape(s) {
      return s.keys().hasOnly(['algorithm', 'packageVersion', 'codecVersion', 'state', 'snapshot']) && s.algorithm == 'fsrs' && s.packageVersion == '5.4.2' && s.codecVersion == 2
        && s.state in ['new', 'learning', 'review', 'relearning'] && nonblank(s.snapshot, 20000);
    }
    function cardShape(d, uid, id) {
      return d.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'unitId', 'encodingId', 'encodingVersion', 'target', 'lifecycle', 'scheduler', 'dueAt', 'lastReviewedAt', 'lastEventId'])
        && d.target in ['concept', 'explanation', 'verbatim'] && d.id == d.encodingId + '_' + d.target && d.encodingVersion == 1 && d.lifecycle == 'active'
        && d.dueAt is timestamp && schedulerShape(d.scheduler);
    }
    function eventAllowsRating(d) {
      let stage = d.stageCompletion;
      return d.rating in ['again', 'hard', 'good', 'easy'] && d.highestHint is int && d.highestHint >= 0 && d.highestHint <= 3
        && d.attemptedBeforeReveal is bool && d.successfulRecall is bool && d.noCriticalError is bool
        && stage.keys().hasOnly(['scene', 'meaning', 'structure', 'verbatim']) && stage.scene is bool && stage.meaning is bool && stage.structure is bool && stage.verbatim is bool
        && (d.rating == 'again' || (d.attemptedBeforeReveal && d.successfulRecall && d.noCriticalError
          && (d.target == 'verbatim' ? stage.verbatim : stage.scene && stage.meaning && stage.structure)
          && d.highestHint < 3 && (d.highestHint != 2 || d.rating == 'hard') && (d.highestHint != 1 || d.rating in ['hard', 'good'])));
    }
    function validReviewEvent(d, uid, id) {
      let before = get(spacePath(uid, 'cards', d.cardId)).data;
      let after = getAfter(spacePath(uid, 'cards', d.cardId)).data;
      return learningNew(d, uid, id) && d.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'cardId', 'target', 'clientRequestId', 'requestHash', 'rating', 'highestHint', 'attemptedBeforeReveal', 'successfulRecall', 'noCriticalError', 'stageCompletion', 'previousCardVersion', 'newCardVersion', 'reviewedAt', 'dueBefore', 'dueAfter', 'responseRetention', 'attemptText', 'schedulerBefore', 'schedulerAfter'])
        && id == d.clientRequestId && digest(d.requestHash) && eventAllowsRating(d)
        && activeUnit(uid, before.unitId) && d.target == before.target && before.lifecycle == 'active'
        && d.previousCardVersion == before.version && d.newCardVersion == before.version + 1 && after.version == d.newCardVersion && after.lastEventId == id
        && d.dueBefore == before.dueAt && d.dueAfter == after.dueAt && d.schedulerBefore == before.scheduler && d.schedulerAfter == after.scheduler
        && d.reviewedAt == after.lastReviewedAt && d.reviewedAt >= request.time - duration.value(5, 'm') && d.reviewedAt <= request.time + duration.value(5, 'm')
        && d.dueAfter >= d.reviewedAt && d.dueAfter <= d.reviewedAt + duration.value(36501, 'd')
        && ((d.responseRetention == 'metadata-only' && !d.keys().hasAny(['attemptText'])) || (d.responseRetention == 'opt-in' && nonblank(d.attemptText, 20000)));
    }
    match /texts/{textId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid && legacyWritesAllowed(request.auth.uid);
      allow create: if signedIn()
        && legacyWritesAllowed(request.auth.uid)
        && request.resource.data.keys().hasAll(['userId', 'title', 'rawText', 'type', 'chunks', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'title', 'rawText', 'type', 'chunks', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.rawText is string
        && request.resource.data.rawText.size() > 0 && request.resource.data.rawText.size() <= 60000
        && request.resource.data.type in ['prosa', 'poesia']
        && request.resource.data.chunks is list
        && request.resource.data.chunks.size() > 0 && request.resource.data.chunks.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      match /progress/{chunkId} {
        allow read: if ownsText(textId);
        allow delete: if ownsText(textId) && legacyWritesAllowed(request.auth.uid);
        allow create, update: if ownsText(textId) && legacyWritesAllowed(request.auth.uid) && chunkId.matches('chunk_[0-9]+')
          && request.resource.data.keys().hasAll(['interval', 'ease', 'nextReview'])
          && request.resource.data.keys().hasOnly(['interval', 'ease', 'nextReview'])
          && request.resource.data.interval is int && request.resource.data.interval >= 0
          && request.resource.data.ease is number && request.resource.data.ease >= 1.3
          && request.resource.data.nextReview is int && request.resource.data.nextReview >= 0;
      }
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
      function newLiteral(d, id) { return d.id == id && d.userId == uid && d.schemaVersion == 2 && d.version == 1 && d.createdAt == request.time; }
      function literalProgram(d) { return get(spacePath(uid, 'literalPrograms', d.programId)).data; }
      function literalActive(d) { return activeSource(uid, d.sourceId) && literalProgram(d).sourceId == d.sourceId; }
      match /literalMemberships/{id} {
        allow create: if owner(uid) && writable(uid) && activeUnit(uid, id)
          && request.resource.data.keys().hasOnly(['id', 'unitId', 'userId', 'sourceId', 'sourceRevisionId', 'createdAt'])
          && request.resource.data.id == id && request.resource.data.unitId == id && request.resource.data.userId == uid && request.resource.data.createdAt == request.time
          && request.resource.data.sourceId == get(spacePath(uid, 'units', id)).data.sourceId && request.resource.data.sourceRevisionId == get(spacePath(uid, 'units', id)).data.sourceRevisionId;
      }
      match /literalPrograms/{id} {
        allow create: if owner(uid) && writable(uid) && newLiteral(request.resource.data, id)
          && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'sourceId', 'sourceRevisionId', 'goal', 'profile', 'unitIds', 'ranges', 'contentHash', 'requestHash'])
          && activeSource(uid, request.resource.data.sourceId)
          && get(spacePath(uid, 'sources', request.resource.data.sourceId)).data.currentRevisionId == request.resource.data.sourceRevisionId
          && request.resource.data.goal in ['literal', 'combined'] && request.resource.data.unitIds is list && request.resource.data.unitIds.size() > 0 && request.resource.data.unitIds.size() <= 200
          && request.resource.data.ranges is list && request.resource.data.ranges.size() == request.resource.data.unitIds.size()
          && request.resource.data.profile.keys().hasOnly(['version', 'caseSensitive', 'punctuation', 'diacritics', 'whitespace', 'latinIJ', 'latinUV'])
          && request.resource.data.profile.version == 1 && request.resource.data.profile.caseSensitive is bool && request.resource.data.profile.punctuation is bool && request.resource.data.profile.diacritics is bool && request.resource.data.profile.latinIJ is bool && request.resource.data.profile.latinUV is bool && request.resource.data.profile.whitespace in ['exact', 'collapse', 'ignore'] && digest(request.resource.data.requestHash) && digest(request.resource.data.contentHash);
      }
      match /literalExercises/{id} {
        allow create: if owner(uid) && writable(uid) && newLiteral(request.resource.data, id) && literalActive(request.resource.data)
          && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'sourceId', 'programId', 'sourceRevisionId', 'start', 'end', 'scope'])
          && request.resource.data.sourceRevisionId == literalProgram(request.resource.data).sourceRevisionId
          && request.resource.data.start is int && request.resource.data.end is int && request.resource.data.start >= 0 && request.resource.data.end > request.resource.data.start && request.resource.data.end <= literalProgram(request.resource.data).unitIds.size()
          && request.resource.data.scope in ['segment', 'sequence', 'transition', 'section', 'whole']
          && (request.resource.data.scope != 'whole' || (request.resource.data.start == 0 && request.resource.data.end == literalProgram(request.resource.data).unitIds.size()))
          && (request.resource.data.scope != 'segment' || request.resource.data.end == request.resource.data.start + 1)
          && (request.resource.data.scope != 'transition' || request.resource.data.end == request.resource.data.start + 2)
          && getAfter(spacePath(uid, 'literalCards', id)).data.exerciseId == id;
      }
      match /literalCards/{id} {
        allow create: if owner(uid) && writable(uid) && newLiteral(request.resource.data, id) && literalActive(request.resource.data)
          && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'sourceId', 'programId', 'exerciseId', 'scope', 'start', 'end', 'lifecycle', 'scheduler', 'dueAt', 'lastReviewedAt', 'lastEventId'])
          && request.resource.data.exerciseId == id && request.resource.data.lifecycle == 'active' && schedulerShape(request.resource.data.scheduler) && request.resource.data.scheduler.state == 'new'
          && request.resource.data.lastReviewedAt == null && request.resource.data.lastEventId == null
          && request.resource.data.dueAt >= request.time - duration.value(5, 'm') && request.resource.data.dueAt <= request.time + duration.value(5, 'm')
          && getAfter(spacePath(uid, 'literalExercises', id)).data.start == request.resource.data.start && getAfter(spacePath(uid, 'literalExercises', id)).data.end == request.resource.data.end
          && getAfter(spacePath(uid, 'literalExercises', id)).data.scope == request.resource.data.scope && getAfter(spacePath(uid, 'literalExercises', id)).data.programId == request.resource.data.programId;
        allow update: if owner(uid) && writable(uid) && activeSource(uid, resource.data.sourceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'scheduler', 'dueAt', 'lastReviewedAt', 'lastEventId']) && request.resource.data.version == resource.data.version + 1 && schedulerShape(request.resource.data.scheduler)
          && !exists(spacePath(uid, 'literalAttempts', request.resource.data.lastEventId))
          && getAfter(spacePath(uid, 'literalAttempts', request.resource.data.lastEventId)).data.cardId == id
          && getAfter(spacePath(uid, 'literalAttempts', request.resource.data.lastEventId)).data.newCardVersion == request.resource.data.version;
      }
      match /literalHints/{id} {
        allow create: if owner(uid) && writable(uid) && request.resource.data.id == id && request.resource.data.userId == uid && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['id', 'userId', 'sourceId', 'programId', 'exerciseId', 'sessionId', 'level', 'createdAt'])
          && request.resource.data.level in [1, 2, 3] && literalActive(request.resource.data) && get(spacePath(uid, 'literalCards', request.resource.data.exerciseId)).data.programId == request.resource.data.programId;
      }
      match /literalAttempts/{id} {
        allow create: if owner(uid) && writable(uid) && newLiteral(request.resource.data, id) && literalActive(request.resource.data)
          && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'sourceId', 'programId', 'cardId', 'exerciseId', 'scope', 'requestHash', 'rating', 'cap', 'verification', 'highestHint', 'revealed', 'manualCorrect', 'complete', 'conforms', 'rawExact', 'lexicalSimilarity', 'ambiguous', 'profile', 'previousCardVersion', 'newCardVersion', 'schedulerBefore', 'schedulerAfter', 'dueBefore', 'dueAfter', 'responseRetention', 'attemptText'])
          && request.resource.data.verification in ['manual', 'automatic'] && request.resource.data.highestHint in [0, 1, 2, 3] && request.resource.data.rating in ['again', 'hard', 'good', 'easy']
          && (request.resource.data.rating == 'again' || (request.resource.data.complete && !request.resource.data.revealed && request.resource.data.highestHint < 3
            && (request.resource.data.verification == 'manual' ? request.resource.data.manualCorrect && request.resource.data.rating != 'easy' : request.resource.data.conforms)
            && (request.resource.data.highestHint < 2 || request.resource.data.rating == 'hard') && (request.resource.data.highestHint < 1 || request.resource.data.rating != 'easy')))
          && request.resource.data.programId == get(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.programId && request.resource.data.exerciseId == request.resource.data.cardId && request.resource.data.scope == get(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.scope
          && getAfter(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.lastReviewedAt >= request.time - duration.value(5, 'm') && getAfter(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.lastReviewedAt <= request.time + duration.value(5, 'm')
          && request.resource.data.profile == literalProgram(request.resource.data).profile && digest(request.resource.data.requestHash)
          && request.resource.data.sourceId == get(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.sourceId
          && request.resource.data.previousCardVersion == get(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.version
          && request.resource.data.newCardVersion == request.resource.data.previousCardVersion + 1
          && getAfter(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.lastEventId == id
          && request.resource.data.schedulerBefore == get(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.scheduler
          && request.resource.data.schedulerAfter == getAfter(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.scheduler
          && request.resource.data.dueBefore == get(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.dueAt
          && request.resource.data.dueAfter == getAfter(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.dueAt
          && request.resource.data.dueAfter >= getAfter(spacePath(uid, 'literalCards', request.resource.data.cardId)).data.lastReviewedAt
          && ((request.resource.data.responseRetention == 'metadata-only' && !request.resource.data.keys().hasAny(['attemptText'])) || (request.resource.data.responseRetention == 'opt-in' && request.resource.data.attemptText is string && request.resource.data.attemptText.size() <= 120000));
      }
      match /literalBindings/{id} {
        allow create: if owner(uid) && writable(uid) && newLiteral(request.resource.data, id) && literalActive(request.resource.data)
          && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'sourceId', 'programId', 'sourceRevisionId', 'start', 'end', 'locusId', 'purpose', 'scene'])
          && request.resource.data.sourceRevisionId == literalProgram(request.resource.data).sourceRevisionId
          && request.resource.data.start is int && request.resource.data.end is int && request.resource.data.start >= 0 && request.resource.data.end > request.resource.data.start && request.resource.data.end <= literalProgram(request.resource.data).unitIds.size()
          && request.resource.data.scene is string && request.resource.data.scene.size() <= 4000 && request.resource.data.purpose in ['sequence', 'start', 'transition']
          && getAfter(spacePath(uid, 'microStations', request.resource.data.locusId)).data.activeBinding == {'kind': 'literal', 'id': id};
      }
      match /sources/{id} {
        allow update: if owner(uid) && writable(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifecycle', 'version']) && request.resource.data.version == resource.data.version + 1 && request.resource.data.lifecycle in ['active', 'archived'] && request.resource.data.lifecycle != resource.data.lifecycle && getAfter(spacePath(uid, 'sourceEvents', id + '_v' + string(request.resource.data.version))).data.newVersion == request.resource.data.version;
        allow create: if owner(uid) && writable(uid) && learningNew(request.resource.data, uid, id)
          && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'title', 'kind', 'lifecycle', 'currentRevisionId', 'provenance', 'creationRequestHash'])
          && nonblank(request.resource.data.title, 120) && request.resource.data.kind in ['prose', 'poetry'] && request.resource.data.lifecycle == 'active'
          && request.resource.data.provenance == {'type': 'user'} && digest(request.resource.data.creationRequestHash) && request.resource.data.currentRevisionId == 'r1'
          && getAfter(/databases/$(database)/documents/users/$(uid)/sources/$(id)/revisions/r1).data.sourceId == id;
        match /revisions/{revisionId} {
          allow create: if owner(uid) && writable(uid) && (learningNew(request.resource.data, uid, revisionId) || newLiteral(request.resource.data, revisionId)) && revisionId == 'r1' && !exists(spacePath(uid, 'sources', id))
            && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'sourceId', 'revisionNumber', 'originalText', 'contentHash', 'hashAlgorithm', 'language', 'segmentationMode', 'provenance', 'edition', 'learningGoal'])
            && request.resource.data.sourceId == id && request.resource.data.revisionNumber == 1 && nonblank(request.resource.data.originalText, 60000) && digest(request.resource.data.contentHash)
            && request.resource.data.hashAlgorithm == 'sha256-canonical-json-v1' && request.resource.data.language is string && request.resource.data.language.size() > 0 && request.resource.data.language.size() <= 100 && (request.resource.data.schemaVersion == 1 || (request.resource.data.learningGoal in ['conceptual', 'literal', 'combined'] && request.resource.data.edition is string && request.resource.data.edition.size() <= 500)) && request.resource.data.segmentationMode in ['sentences', 'verses', 'stanzas', 'paragraphs', 'manual-reviewed']
            && request.resource.data.provenance == {'type': 'user'} && getAfter(spacePath(uid, 'sources', id)).data.currentRevisionId == revisionId;
        }
      }
      match /sourceOperations/{id} {
        allow create: if owner(uid) && writable(uid) && request.resource.data.keys().hasOnly(['id', 'userId', 'sourceId', 'target', 'changed', 'outcomeVersion', 'createdAt'])
          && request.resource.data.id == id && request.resource.data.userId == uid && request.resource.data.createdAt == request.time && request.resource.data.target in ['active', 'archived']
          && request.resource.data.outcomeVersion == getAfter(spacePath(uid, 'sources', request.resource.data.sourceId)).data.version
          && request.resource.data.target == getAfter(spacePath(uid, 'sources', request.resource.data.sourceId)).data.lifecycle
          && (request.resource.data.changed ? getAfter(spacePath(uid, 'sourceEvents', request.resource.data.sourceId + '_v' + string(request.resource.data.outcomeVersion))).data.requestId == id : get(spacePath(uid, 'sources', request.resource.data.sourceId)).data.lifecycle == request.resource.data.target);
      }
      match /sourceEvents/{id} {
        allow create: if owner(uid) && writable(uid) && request.resource.data.keys().hasOnly(['id', 'requestId', 'userId', 'sourceId', 'from', 'to', 'previousVersion', 'newVersion', 'createdAt']) && request.resource.data.id == id && id == request.resource.data.sourceId + '_v' + string(request.resource.data.newVersion) && request.resource.data.userId == uid && request.resource.data.createdAt == request.time && request.resource.data.from == get(spacePath(uid, 'sources', request.resource.data.sourceId)).data.lifecycle && request.resource.data.to == getAfter(spacePath(uid, 'sources', request.resource.data.sourceId)).data.lifecycle && request.resource.data.previousVersion == get(spacePath(uid, 'sources', request.resource.data.sourceId)).data.version && request.resource.data.newVersion == getAfter(spacePath(uid, 'sources', request.resource.data.sourceId)).data.version && request.resource.data.newVersion == request.resource.data.previousVersion + 1;
      }
      // Publication guards live on the mandatory unit transition. Every new encoding
      // proves that transition (before/after version), avoiding redundant get() calls
      // and keeping the linked three-card publication within Firestore evaluation limits.
      match /units/{id} {
        allow create: if owner(uid) && writable(uid) && learningNew(request.resource.data, uid, id) && unitShape(request.resource.data, uid, id)
          && request.resource.data.status == 'needs_concept' && request.resource.data.targetMode == null && request.resource.data.targets == []
          && request.resource.data.primaryConceptId == null && request.resource.data.activeEncodingId == null && request.resource.data.legacyRef == null
          && get(spacePath(uid, 'sources', request.resource.data.sourceId)).data.lifecycle == 'active'
          && get(spacePath(uid, 'sources', request.resource.data.sourceId)).data.currentRevisionId == request.resource.data.sourceRevisionId
          && get(/databases/$(database)/documents/users/$(uid)/sources/$(request.resource.data.sourceId)/revisions/$(request.resource.data.sourceRevisionId)).data.sourceId == request.resource.data.sourceId
          && getAfter(/databases/$(database)/documents/users/$(uid)/units/$(id)/revisions/v1).data == request.resource.data;
        allow update: if owner(uid) && writable(uid) && activeSource(uid, resource.data.sourceId) && (!exists(spacePath(uid, 'literalMemberships', id)) || request.resource.data.targetMode == 'conceptual') && resource.data.userId == uid && hasSpaceHistory(uid, 'units', id)
          && resource.data.status in ['needs_concept', 'needs_encoding'] && resource.data.get('activeEncodingId', null) == null && request.resource.data.status == 'ready'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'status', 'primaryConceptId', 'targetMode', 'targets', 'activeEncodingId'])
          && getAfter(spacePath(uid, 'encodings', request.resource.data.activeEncodingId)).data.createdAt == request.time && getAfter(spacePath(uid, 'encodings', request.resource.data.activeEncodingId)).data.unitId == id
          && getAfter(spacePath(uid, 'encodings', request.resource.data.activeEncodingId)).data.conceptId == request.resource.data.primaryConceptId
          && getAfter(spacePath(uid, 'encodings', request.resource.data.activeEncodingId)).data.targets == request.resource.data.targets;
      }
      match /encodingDrafts/{id} {
        allow create: if owner(uid) && writable(uid) && learningNew(request.resource.data, uid, id) && activeUnit(uid, id) && validDraft(request.resource.data, uid, id)
          && request.resource.data.status == 'draft' && writable(uid) && activeUnit(uid, id) && request.resource.data.publishedEncodingId == null
          && get(spacePath(uid, 'units', id)).data.status in ['needs_concept', 'needs_encoding'] && get(spacePath(uid, 'units', id)).data.sourceRevisionId == request.resource.data.sourceRevisionId;
        allow update: if owner(uid) && resource.data.userId == uid && request.resource.data.updatedAt == request.time && request.resource.data.version == resource.data.version + 1 && resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'updatedAt', 'payload', 'step', 'status', 'publishedEncodingId'])
          && ((request.resource.data.status == 'draft' && writable(uid) && activeUnit(uid, id) && validDraft(request.resource.data, uid, id) && request.resource.data.publishedEncodingId == null && get(spacePath(uid, 'units', id)).data.status in ['needs_concept', 'needs_encoding'])
            || (request.resource.data.status == 'published' && request.resource.data.payload == resource.data.payload && request.resource.data.step == resource.data.step
              && getAfter(spacePath(uid, 'encodings', request.resource.data.publishedEncodingId)).data.draftId == id && getAfter(spacePath(uid, 'units', id)).data.activeEncodingId == request.resource.data.publishedEncodingId));
      }
      match /concepts/{id} {
        allow create: if owner(uid) && learningNew(request.resource.data, uid, id)
          && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'canonicalProposition', 'kind', 'terms', 'premises', 'conclusion', 'whyItFollows', 'status', 'encodingId'])
          && id == request.resource.data.encodingId + '_concept' && request.resource.data.status == 'reviewed'
          && request.resource.data.terms is list && request.resource.data.premises is list && request.resource.data.conclusion is string && request.resource.data.whyItFollows is string
          && (request.resource.data.kind != 'argument' || (request.resource.data.premises.size() > 0 && nonblank(request.resource.data.conclusion, 4000) && nonblank(request.resource.data.whyItFollows, 4000)))
          && getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.createdAt == request.time
          && getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.conceptId == id;
      }
      match /conceptEdges/{id} {
        allow create: if owner(uid) && learningNew(request.resource.data, uid, id)
          && request.resource.data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'version', 'createdAt', 'encodingId', 'fromConceptId', 'toConceptId', 'type', 'explanation', 'evidenceUnitIds'])
          && id == request.resource.data.encodingId + '_edge' && request.resource.data.fromConceptId != request.resource.data.toConceptId && nonblank(request.resource.data.explanation, 4000)
          && request.resource.data.type in ['causes', 'implies', 'contrasts', 'defines', 'example_of', 'depends_on', 'argument_order']
          && get(spacePath(uid, 'concepts', request.resource.data.toConceptId)).data.status == 'reviewed'
          && getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.createdAt == request.time
          && getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.edgeId == id
          && getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.conceptId == request.resource.data.fromConceptId
          && request.resource.data.evidenceUnitIds == [getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.unitId];
      }
      match /encodings/{id} { allow create: if owner(uid) && publishableEncoding(request.resource.data, uid, id); }
      match /cards/{id} {
        allow create: if owner(uid) && learningNew(request.resource.data, uid, id) && cardShape(request.resource.data, uid, id)
          && request.resource.data.scheduler.state == 'new' && request.resource.data.lastReviewedAt == null && request.resource.data.lastEventId == null
          && request.resource.data.dueAt >= request.time - duration.value(5, 'm') && request.resource.data.dueAt <= request.time + duration.value(5, 'm')
          && getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.createdAt == request.time
          && getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.unitId == request.resource.data.unitId
          && getAfter(spacePath(uid, 'encodings', request.resource.data.encodingId)).data.targets.hasAny([request.resource.data.target]);
        allow update: if owner(uid) && writable(uid) && resource.data.userId == uid && activeUnit(uid, resource.data.unitId) && schedulerShape(request.resource.data.scheduler) && resource.data.lifecycle == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'scheduler', 'dueAt', 'lastReviewedAt', 'lastEventId'])
          && request.resource.data.version == resource.data.version + 1 && request.resource.data.lastEventId != resource.data.lastEventId
          && !exists(spacePath(uid, 'reviewEvents', request.resource.data.lastEventId))
          && getAfter(spacePath(uid, 'reviewEvents', request.resource.data.lastEventId)).data.cardId == id
          && getAfter(spacePath(uid, 'reviewEvents', request.resource.data.lastEventId)).data.newCardVersion == request.resource.data.version
          && get(spacePath(uid, 'encodings', resource.data.encodingId)).data.status == 'active';
      }
      match /reviewEvents/{id} { allow create: if owner(uid) && writable(uid) && validReviewEvent(request.resource.data, uid, id); }
      match /palaces/{id} {
        allow create: if owner(uid) && writable(uid) && palaceShape(request.resource.data, uid, id) && newSpace(request.resource.data, uid, id)
          && request.resource.data.lifecycle == 'active' && request.resource.data.activeMacroCount == 0 && request.resource.data.lastMutation == null;
        allow update: if owner(uid) && writable(uid) && palaceShape(request.resource.data, uid, id) && hasSpaceHistory(uid, 'palaces', id)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'activeMacroCount', 'lastMutation'])
              && resource.data.lifecycle == 'active' && childTransition(uid, 'macroStations', id, 'palaceId', 'lifecycle', 'activeMacroCount'))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'lifecycle'])
              && resource.data.activeMacroCount == 0 && resource.data.lifecycle != request.resource.data.lifecycle));
      }
      match /macroStations/{id} {
        allow create: if owner(uid) && writable(uid) && macroShape(request.resource.data, uid, id) && newSpace(request.resource.data, uid, id)
          && request.resource.data.lifecycle == 'active' && request.resource.data.activeLocusCount == 0 && request.resource.data.lastMutation == null
          && parentTransition(uid, 'palaces', request.resource.data.palaceId, 'activeMacroCount', id, 'create');
        allow update: if owner(uid) && writable(uid) && macroShape(request.resource.data, uid, id) && hasSpaceHistory(uid, 'macroStations', id)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'activeLocusCount', 'lastMutation'])
              && resource.data.lifecycle == 'active' && childTransition(uid, 'microStations', id, 'macroId', 'state', 'activeLocusCount'))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'lifecycle'])
              && resource.data.activeLocusCount == 0 && resource.data.lifecycle != request.resource.data.lifecycle
              && parentTransition(uid, 'palaces', resource.data.palaceId, 'activeMacroCount', id, request.resource.data.lifecycle == 'archived' ? 'archive' : 'restore')));
      }
      match /microStations/{id} {
        allow create: if owner(uid) && writable(uid) && locusShape(request.resource.data, uid, id) && newSpace(request.resource.data, uid, id)
          && request.resource.data.state == 'free' && request.resource.data.activeEncodingId == null && request.resource.data.usageCountLifetime == 0
          && get(spacePath(uid, 'palaces', request.resource.data.palaceId)).data.lifecycle == 'active'
          && get(spacePath(uid, 'macroStations', request.resource.data.macroId)).data.palaceId == request.resource.data.palaceId
          && parentTransition(uid, 'macroStations', request.resource.data.macroId, 'activeLocusCount', id, 'create');
        allow update: if owner(uid) && writable(uid) && resource.data.userId == uid && hasSpaceHistory(uid, 'microStations', id)
          && ((request.resource.data.activeEncodingId is string && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'state', 'activeEncodingId', 'usageCountLifetime'])
              && resource.data.state == 'free' && resource.data.activeEncodingId == null && request.resource.data.state == 'occupied'
              && request.resource.data.usageCountLifetime == resource.data.usageCountLifetime + 1
              && getAfter(spacePath(uid, 'encodings', request.resource.data.activeEncodingId)).data.locusId == id
              && getAfter(spacePath(uid, 'encodings', request.resource.data.activeEncodingId)).data.createdAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'state', 'schemaVersion', 'activeBinding', 'activeEncodingId', 'usageCountLifetime']) && request.resource.data.schemaVersion == 2 && resource.data.state == 'free' && resource.data.activeEncodingId == null && resource.data.get('activeBinding', null) == null && request.resource.data.state == 'occupied' && request.resource.data.activeEncodingId == null && request.resource.data.activeBinding.kind == 'literal' && request.resource.data.usageCountLifetime == resource.data.usageCountLifetime + 1 && getAfter(spacePath(uid, 'literalBindings', request.resource.data.activeBinding.id)).data.locusId == id && getAfter(spacePath(uid, 'literalBindings', request.resource.data.activeBinding.id)).data.createdAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'state']) && resource.data.state == 'cooling' && request.resource.data.state == 'free' && resource.data.activeEncodingId == null && resource.data.get('activeBinding', null) == null)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'state'])
          && resource.data.activeEncodingId == null && request.resource.data.activeEncodingId == null
          && ((resource.data.state == 'free' && request.resource.data.state == 'archived') || (resource.data.state == 'archived' && request.resource.data.state == 'free'))
          && parentTransition(uid, 'macroStations', resource.data.macroId, 'activeLocusCount', id, request.resource.data.state == 'archived' ? 'archive' : 'restore'))
);
      }
      match /{collectionId}/{documentId} {
        allow read: if owner(uid) && collectionId in [
          'sources', 'units', 'concepts', 'conceptEdges', 'palaces', 'macroStations',
          'microStations', 'encodings', 'encodingDrafts', 'cards', 'reviewAttempts',
          'reviewEvents', 'studySessions', 'spaceEvents', 'migrationJobs',
          'legacyLinks', 'legacyProgress', 'settings', 'sourceEvents', 'sourceOperations', 'literalHints', 'literalMemberships', 'deletionJobs', 'control', 'literalPrograms', 'literalExercises', 'literalCards', 'literalAttempts', 'literalBindings'
        ];
        allow write: if false;
        match /revisions/{revisionId} {
          allow read: if owner(uid) && collectionId in ['sources', 'units', 'concepts', 'encodings', 'palaces', 'macroStations', 'microStations'];
          allow create: if owner(uid) && collectionId in ['palaces', 'macroStations', 'microStations', 'units']
            && revisionId == 'v' + string(get(spacePath(uid, collectionId, documentId)).data.version)
            && request.resource.data == get(spacePath(uid, collectionId, documentId)).data
            && getAfter(spacePath(uid, collectionId, documentId)).data.version == request.resource.data.version + 1;
          allow create: if owner(uid) && collectionId == 'units' && revisionId == 'v1' && !exists(spacePath(uid, 'units', documentId))
            && request.resource.data == getAfter(spacePath(uid, 'units', documentId)).data && request.resource.data.version == 1;
          allow update, delete: if false;
        }
      }
    }
  }
}
