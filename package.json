  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "@eslint/js": "9.39.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "playwright": "1.62.1",
    "vite": "8.3.4"
  }
}
